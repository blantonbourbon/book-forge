---
import {
  DEFAULT_FORM_VALUES,
  DEFAULT_MAX_DURATION_MILLIS,
  DEFAULT_MAX_TOTAL_BYTES,
  MAX_CRAWL_DEPTH,
  MAX_CRAWL_PAGES,
} from "../lib/form-state";
import {
  READER_GUIDANCE_COPY,
  refreshRecoveryPresentation,
} from "../lib/terminal-state";

const defaults = DEFAULT_FORM_VALUES;
const initialRecovery = refreshRecoveryPresentation();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Book Forge</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/assets/fonts/zed-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/assets/book-forge.css" />
  </head>
  <body>
    <a class="skip-link" href="#conversion-form">Skip to form</a>
    <header class="hero">
      <div class="hero-topline">
        <div>
          <h1>
            <svg
              class="hero-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              fill="currentColor"
              viewBox="0 0 256 256"
              aria-hidden="true"
              ><path
                d="M232,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H24a8,8,0,0,0-8,8V200a8,8,0,0,0,8,8H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h72a8,8,0,0,0,8-8V56A8,8,0,0,0,232,48ZM96,192H32V64H96a24,24,0,0,1,24,24V200A39.81,39.81,0,0,0,96,192Zm128,0H160a39.81,39.81,0,0,0-24,8V88a24,24,0,0,1,24-24h64Z"
              ></path></svg
            >
            Book Forge
          </h1>
          <p class="hero-copy">Convert web pages into EPUB downloads.</p>
        </div>
        <div id="auth-panel" class="auth-panel" hidden>
          <a id="login-link" class="auth-link" href="/api/auth/login" hidden>
            Sign in with GitHub
          </a>
          <div id="user-menu" class="user-menu" hidden>
            <span id="user-label" class="user-label"></span>
            <button id="logout-button" class="secondary-button" type="button">
              Sign out
            </button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section class="app-grid" aria-label="Book Forge conversion workflow">
        <form id="conversion-form" class="card conversion-form" novalidate>
          <div class="section-heading">
            <p class="eyebrow">Configure</p>
            <h2>Forge an EPUB</h2>
          </div>

          <div
            id="validation-summary"
            class="validation-summary"
            role="alert"
            tabindex="-1"
            hidden
          >
          </div>

          <div class="field">
            <label for="source-url">Source URL</label>
            <input
              id="source-url"
              name="sourceUrl"
              type="url"
              inputmode="url"
              autocomplete="url"
              placeholder="https://example.test/page.html"
              value={defaults.sourceUrl}
              required
              aria-describedby="source-url-error"
            />
            <p
              id="source-url-error"
              class="field-error"
              data-field-error="sourceUrl"
            >
            </p>
          </div>

          <fieldset class="segmented-fieldset">
            <legend>Mode</legend>
            <div class="segmented-control">
              <label>
                <input
                  type="radio"
                  name="mode"
                  value="single"
                  checked={defaults.mode === "single"}
                />
                <span>
                  <strong>Single page</strong>
                  <small>One source, one chapter.</small>
                </span>
              </label>
              <label>
                <input
                  type="radio"
                  name="mode"
                  value="crawl"
                  checked={defaults.mode === "crawl"}
                />
                <span>
                  <strong>Crawl</strong>
                  <small>Scoped pages, ordered chapters.</small>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Metadata</legend>
            <p id="metadata-status" class="metadata-status" aria-live="polite">
            </p>
            <div class="field-grid">
              <div class="field">
                <label for="book-title">Title</label>
                <input
                  id="book-title"
                  name="title"
                  type="text"
                  value={defaults.title}
                  required
                  maxlength="512"
                  aria-describedby="book-title-error"
                />
                <p
                  id="book-title-error"
                  class="field-error"
                  data-field-error="title"
                >
                </p>
              </div>
              <div class="field">
                <label for="book-author">Author</label>
                <input
                  id="book-author"
                  name="author"
                  type="text"
                  value={defaults.author}
                  maxlength="512"
                  aria-describedby="book-author-error"
                />
                <p
                  id="book-author-error"
                  class="field-error"
                  data-field-error="author"
                >
                </p>
              </div>
            </div>
            <div class="field">
              <label for="book-description">Description</label>
              <textarea
                id="book-description"
                name="description"
                rows="3"
                maxlength="512"
                aria-describedby="book-description-error"
                >{defaults.description}</textarea
              >
              <p
                id="book-description-error"
                class="field-error"
                data-field-error="description"
              >
              </p>
            </div>
          </fieldset>

          <fieldset>
            <legend>Options</legend>
            <div class="options-stack">
              <label class="option-row">
                <input
                  id="include-images"
                  name="includeImages"
                  type="checkbox"
                  checked={defaults.includeImages}
                />
                <span>
                  <strong>Include images</strong>
                  <small>Embed reachable, safe images only.</small>
                </span>
              </label>

              <label class="option-row">
                <input
                  id="use-browser"
                  name="useBrowser"
                  type="checkbox"
                  checked={defaults.useBrowser}
                />
                <span>
                  <strong>Use browser rendering</strong>
                  <small>Fetch via headless browser for blocked sites.</small>
                </span>
              </label>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="chapter-strategy">Chapters</label>
                <select id="chapter-strategy" name="chapterStrategy">
                  <option
                    value="source-order"
                    selected={defaults.chapterStrategy === "source-order"}
                  >
                    Source order
                  </option>
                  <option
                    value="single-document"
                    selected={defaults.chapterStrategy === "single-document"}
                  >
                    Keep content grouped
                  </option>
                </select>
              </div>
              <div class="field">
                <label for="output-target">Output</label>
                <select id="output-target" name="outputTarget">
                  <option
                    value="epub"
                    selected={defaults.outputTarget === "epub"}
                  >
                    EPUB (.epub)
                  </option>
                </select>
              </div>
            </div>
          </fieldset>

          <section
            id="crawl-options"
            class="crawl-options"
            aria-labelledby="crawl-heading"
            hidden
          >
            <div class="section-heading compact">
              <p class="eyebrow">Crawl</p>
              <h3 id="crawl-heading">Scope</h3>
            </div>
            <div class="field">
              <label for="crawl-prefix-url">Prefix URL</label>
              <input
                id="crawl-prefix-url"
                name="crawlPrefixUrl"
                type="url"
                inputmode="url"
                placeholder="https://example.test/docs/"
                value={defaults.crawlPrefixUrl}
                aria-describedby="crawl-prefix-url-error"
              />
              <p
                id="crawl-prefix-url-error"
                class="field-error"
                data-field-error="crawlPrefixUrl"
              >
              </p>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="max-depth">Max depth</label>
                <input
                  id="max-depth"
                  name="maxDepth"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max={MAX_CRAWL_DEPTH}
                  step="1"
                  value={defaults.maxDepth}
                  aria-describedby="max-depth-error"
                />
                <p
                  id="max-depth-error"
                  class="field-error"
                  data-field-error="maxDepth"
                >
                </p>
              </div>
              <div class="field">
                <label for="max-pages">Max pages</label>
                <input
                  id="max-pages"
                  name="maxPages"
                  type="number"
                  inputmode="numeric"
                  min="1"
                  max={MAX_CRAWL_PAGES}
                  step="1"
                  value={defaults.maxPages}
                  aria-describedby="max-pages-error"
                />
                <p
                  id="max-pages-error"
                  class="field-error"
                  data-field-error="maxPages"
                >
                </p>
              </div>
            </div>
            <p class="help">
              Bounded to {MAX_CRAWL_PAGES} pages at depth {MAX_CRAWL_DEPTH}, {
                DEFAULT_MAX_TOTAL_BYTES.toLocaleString()
              } bytes, {DEFAULT_MAX_DURATION_MILLIS / 1000}s.
            </p>
          </section>

          <div class="actions">
            <button id="submit-button" type="submit">
              <svg
                class="btn-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 256 256"
                aria-hidden="true"
                ><path
                  d="M224,152v56a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V152a8,8,0,0,1,16,0v56H208V152a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,132.69V40a8,8,0,0,0-16,0v92.69L93.66,106.34a8,8,0,0,0-11.32,11.32Z"
                ></path></svg
              >
              <span id="submit-label">Forge EPUB</span>
            </button>
          </div>
        </form>

        <aside class="side-stack" aria-label="Status">
          <section
            id="job-status"
            class="card status-card"
            role="status"
            aria-live="polite"
            aria-atomic="false"
            tabindex="-1"
            data-phase="idle"
          >
            <div class="section-heading compact">
              <p class="eyebrow">Status</p>
              <h2>Progress</h2>
            </div>
            <p id="status-text">{initialRecovery.statusText}</p>
            <div
              id="progress-wrap"
              class="progress-wrap"
              role="progressbar"
              aria-label="Conversion progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              hidden
            >
              <span id="progress-bar"></span>
            </div>
            <dl id="job-summary" class="job-summary" hidden>
              <div>
                <dt>Job</dt>
                <dd id="summary-job"></dd>
              </div>
              <div>
                <dt>Mode</dt>
                <dd id="summary-mode"></dd>
              </div>
              <div>
                <dt>Title</dt>
                <dd id="summary-title">{defaults.title}</dd>
              </div>
              <div>
                <dt>Options</dt>
                <dd id="summary-options"></dd>
              </div>
            </dl>
            <div id="warning-list" class="message-list warning-list" hidden>
            </div>
            <div
              id="error-list"
              class="message-list error-list"
              role="alert"
              hidden
            >
            </div>
            <a id="download-link" class="download-link" href="#" hidden>
              {READER_GUIDANCE_COPY.downloadLabel}
            </a>
          </section>

          <section id="reader-guidance" class="card guidance-card">
            <p>{READER_GUIDANCE_COPY.body}</p>
          </section>
        </aside>
      </section>
    </main>

    <script>
      import {
        ApiClientError,
        createJob,
        getAuthSession,
        getJob,
        loginUrlForReturnTo,
        previewMetadata,
        signOut,
        type ApiErrorBody,
        type ApiWarning,
        type AuthSession,
        type JobResponse,
        type MetadataPreview,
      } from "../lib/api";
      import {
        applyMode,
        buildCreateJobPayload,
        canSubmitInPhase,
        cloneDefaultFormValues,
        validateForm,
        type FormField,
        type FormValues,
        type UiPhase,
        type ValidationResult,
      } from "../lib/form-state";
      import {
        jobPresentationForJob,
        pollingFailurePresentation,
        preStartFailurePresentation,
        statusMessageDisplayText,
      } from "../lib/terminal-state";

      const form = document.querySelector<HTMLFormElement>("#conversion-form");
      const validationSummary = document.querySelector<HTMLElement>(
        "#validation-summary",
      );
      const submitButton =
        document.querySelector<HTMLButtonElement>("#submit-button");
      const submitLabel =
        document.querySelector<HTMLSpanElement>("#submit-label");
      const crawlOptions =
        document.querySelector<HTMLElement>("#crawl-options");
      const statusCard = document.querySelector<HTMLElement>("#job-status");
      const statusText = document.querySelector<HTMLElement>("#status-text");
      const progressWrap =
        document.querySelector<HTMLElement>("#progress-wrap");
      const progressBar = document.querySelector<HTMLElement>("#progress-bar");
      const jobSummary = document.querySelector<HTMLElement>("#job-summary");
      const metadataStatus =
        document.querySelector<HTMLElement>("#metadata-status");
      const warningList = document.querySelector<HTMLElement>("#warning-list");
      const errorList = document.querySelector<HTMLElement>("#error-list");
      const downloadLink =
        document.querySelector<HTMLAnchorElement>("#download-link");
      const authPanel = document.querySelector<HTMLElement>("#auth-panel");
      const loginLink =
        document.querySelector<HTMLAnchorElement>("#login-link");
      const userMenu = document.querySelector<HTMLElement>("#user-menu");
      const userLabel = document.querySelector<HTMLElement>("#user-label");
      const logoutButton =
        document.querySelector<HTMLButtonElement>("#logout-button");

      const summaryJob = document.querySelector<HTMLElement>("#summary-job");
      const summaryMode = document.querySelector<HTMLElement>("#summary-mode");
      const summaryTitle =
        document.querySelector<HTMLElement>("#summary-title");
      const summaryOptions =
        document.querySelector<HTMLElement>("#summary-options");

      const fieldControls: Partial<Record<FormField, HTMLElement>> = {
        sourceUrl: document.querySelector<HTMLInputElement>("#source-url")!,
        title: document.querySelector<HTMLInputElement>("#book-title")!,
        author: document.querySelector<HTMLInputElement>("#book-author")!,
        description:
          document.querySelector<HTMLTextAreaElement>("#book-description")!,
        includeImages:
          document.querySelector<HTMLInputElement>("#include-images")!,
        useBrowser: document.querySelector<HTMLInputElement>("#use-browser")!,
        chapterStrategy:
          document.querySelector<HTMLSelectElement>("#chapter-strategy")!,
        outputTarget:
          document.querySelector<HTMLSelectElement>("#output-target")!,
        crawlPrefixUrl:
          document.querySelector<HTMLInputElement>("#crawl-prefix-url")!,
        maxDepth: document.querySelector<HTMLInputElement>("#max-depth")!,
        maxPages: document.querySelector<HTMLInputElement>("#max-pages")!,
      };

      const fieldErrors = new Map<FormField, HTMLElement>(
        Array.from(
          document.querySelectorAll<HTMLElement>("[data-field-error]"),
        ).map((element) => [element.dataset.fieldError as FormField, element]),
      );

      let values: FormValues = cloneDefaultFormValues();
      let submittedValues: FormValues = { ...values };
      let phase: UiPhase = "idle";
      let currentJobId: string | null = null;
      let pollTimer: number | undefined;
      let metadataPreviewRequest = 0;
      let lastAutoTitle = "";
      let lastAutoAuthor = "";
      let lastAutoDescription = "";
      let authSession: AuthSession | null = null;

      initialize();

      function initialize() {
        if (!form) {
          return;
        }

        values = readFormValues();
        renderMode();
        renderFieldAvailability();
        renderSubmitState();
        form.addEventListener("input", handleFormInput);
        form.addEventListener("change", handleFormInput);
        form.addEventListener("submit", handleSubmit);
        logoutButton?.addEventListener("click", () => {
          void handleLogout();
        });
        fieldControls.sourceUrl?.addEventListener("blur", () => {
          void maybePreviewMetadata();
        });
        void refreshAuthSession();
      }

      function handleFormInput() {
        const previousMode = values.mode;
        values = readFormValues();
        if (previousMode !== values.mode) {
          values = applyMode(values, values.mode);
        }
        renderMode();
        renderValidation(validateForm(values), false);
      }

      async function maybePreviewMetadata() {
        if (!canUseAuthenticatedApi()) {
          return;
        }

        values = readFormValues();
        const sourceUrl = values.sourceUrl.trim();
        if (!isPreviewableURL(sourceUrl)) {
          return;
        }

        const requestId = ++metadataPreviewRequest;
        if (metadataStatus) {
          metadataStatus.textContent = "Fetching metadata…";
        }

        try {
          const preview = await previewMetadata(sourceUrl, {
            useBrowser: values.useBrowser,
          });
          if (requestId !== metadataPreviewRequest) {
            return;
          }

          applyMetadataPreview(preview);
          const filled =
            Boolean(preview.title) ||
            Boolean(preview.author) ||
            Boolean(preview.description);
          if (metadataStatus) {
            metadataStatus.textContent = filled
              ? "Metadata filled from source."
              : "No metadata found; fill details manually.";
          }
        } catch {
          if (requestId === metadataPreviewRequest && metadataStatus) {
            metadataStatus.textContent =
              "Metadata could not be fetched; fill details manually.";
          }
        }
      }

      function applyMetadataPreview(preview: MetadataPreview) {
        const title = fieldControls.title;
        const author = fieldControls.author;
        const description = fieldControls.description;
        const defaults = cloneDefaultFormValues();

        if (
          preview.title &&
          title instanceof HTMLInputElement &&
          canReplaceMetadata(title.value, defaults.title, lastAutoTitle)
        ) {
          title.value = preview.title;
          lastAutoTitle = preview.title;
        }

        if (
          preview.author &&
          author instanceof HTMLInputElement &&
          canReplaceMetadata(author.value, defaults.author, lastAutoAuthor)
        ) {
          author.value = preview.author;
          lastAutoAuthor = preview.author;
        }

        if (
          preview.description &&
          description instanceof HTMLTextAreaElement &&
          canReplaceMetadata(
            description.value,
            defaults.description,
            lastAutoDescription,
          )
        ) {
          description.value = preview.description;
          lastAutoDescription = preview.description;
        }

        values = readFormValues();
        renderValidation(validateForm(values), false);
      }

      function canReplaceMetadata(
        currentValue: string,
        defaultValue: string,
        lastAutoValue: string,
      ): boolean {
        const current = currentValue.trim();
        return (
          current === "" ||
          current === defaultValue ||
          (lastAutoValue !== "" && current === lastAutoValue)
        );
      }

      function isPreviewableURL(sourceUrl: string): boolean {
        try {
          const parsed = new URL(sourceUrl);
          return parsed.protocol === "http:" || parsed.protocol === "https:";
        } catch {
          return false;
        }
      }

      async function handleSubmit(event: SubmitEvent) {
        event.preventDefault();
        values = readFormValues();

        if (!canUseAuthenticatedApi()) {
          window.location.href = loginUrlForReturnTo();
          return;
        }

        const validation = validateForm(values);
        renderValidation(validation, true);

        if (!validation.canSubmit) {
          focusInvalidField(validation);
          return;
        }

        if (!canSubmitInPhase(phase)) {
          announce(
            "A conversion is already running. Wait for it to finish before submitting again.",
          );
          return;
        }

        clearPollTimer();
        setPhase("submitting");
        submittedValues = { ...values };
        currentJobId = null;
        renderMessages([], []);
        renderProgress(0, false);
        renderDownload(null);
        renderSubmittedSummary();
        announce("Submitting…");

        try {
          const created = await createJob(buildCreateJobPayload(values));
          currentJobId = created.id;
          renderJob(created);

          if (isTerminal(created)) {
            setPhase(created.status);
            return;
          }

          setPhase("polling");
          startPolling(created.id);
        } catch (error) {
          const apiError = normalizeError(error);
          const presentation = preStartFailurePresentation(apiError);
          setPhase(presentation.phase);
          renderProgress(0, presentation.progressVisible);
          renderMessages([], presentation.errors);
          renderDownload(presentation.download.href);
          announce(presentation.statusText);
        }
      }

      async function refreshAuthSession() {
        try {
          authSession = await getAuthSession();
        } catch {
          authSession = {
            authRequired: true,
            authenticated: false,
            loginUrl: "/api/auth/login",
          };
        }
        renderAuthState();
        renderSubmitState();
      }

      async function handleLogout() {
        if (!logoutButton) {
          return;
        }

        logoutButton.disabled = true;
        try {
          authSession = await signOut();
        } catch {
          authSession = {
            authRequired: true,
            authenticated: false,
            loginUrl: "/api/auth/login",
          };
        } finally {
          logoutButton.disabled = false;
        }
        clearPollTimer();
        currentJobId = null;
        setPhase("idle");
        renderProgress(0, false);
        renderDownload(null);
        renderMessages([], []);
        renderAuthState();
        announce("Signed out.");
      }

      function renderAuthState() {
        const requiresAuth = authSession?.authRequired ?? true;
        if (authPanel) {
          authPanel.hidden = !requiresAuth;
        }
        renderFieldAvailability();
        if (!requiresAuth) {
          return;
        }

        const authenticated = authSession?.authenticated ?? false;
        if (loginLink) {
          loginLink.href = loginUrlForReturnTo();
          loginLink.hidden = authenticated;
        }
        if (userMenu) {
          userMenu.hidden = !authenticated;
        }
        if (userLabel) {
          const login = authSession?.user?.login ?? "GitHub";
          userLabel.textContent = `@${login}`;
        }
      }

      function canUseAuthenticatedApi(): boolean {
        return authSession !== null
          ? !authSession.authRequired || authSession.authenticated
          : false;
      }

      function startPolling(jobId: string) {
        const poll = async () => {
          try {
            const job = await getJob(jobId);
            if (jobId !== currentJobId) {
              return;
            }
            renderJob(job);
            if (isTerminal(job)) {
              clearPollTimer();
              setPhase(job.status);
            }
          } catch (error) {
            clearPollTimer();
            const apiError = normalizeError(error);
            const presentation = pollingFailurePresentation(apiError);
            setPhase(presentation.phase);
            renderProgress(0, presentation.progressVisible);
            renderMessages([], presentation.errors);
            renderDownload(presentation.download.href);
            announce(presentation.statusText);
          }
        };

        pollTimer = window.setInterval(poll, 500);
        void poll();
      }

      function renderJob(job: JobResponse) {
        const presentation = jobPresentationForJob(job);
        const percent = clampProgress(job.progress?.percent ?? 0);
        renderProgress(percent, presentation.progressVisible);
        renderSubmittedSummary();
        renderMessages(
          job.warnings ?? [],
          job.errors ?? [],
          presentation.warningHeading,
          presentation.errorHeading,
        );
        renderDownload(presentation.download.href);
        announce(presentation.statusText);
      }

      function renderMode() {
        const isCrawl = values.mode === "crawl";
        if (crawlOptions) {
          crawlOptions.hidden = !isCrawl;
        }
        renderFieldAvailability();
      }

      function renderFieldAvailability() {
        const authBlocked = !canUseAuthenticatedApi();
        const isCrawl = values.mode === "crawl";

        for (const [field, control] of Object.entries(fieldControls) as Array<
          [FormField, HTMLElement | undefined]
        >) {
          if (
            control instanceof HTMLInputElement ||
            control instanceof HTMLSelectElement ||
            control instanceof HTMLTextAreaElement
          ) {
            const crawlField =
              field === "crawlPrefixUrl" ||
              field === "maxDepth" ||
              field === "maxPages";
            control.disabled = authBlocked || (crawlField && !isCrawl);
            if (crawlField) {
              control.required = isCrawl;
            }
          }
        }
      }

      function renderValidation(
        validation: ValidationResult,
        showSummary: boolean,
      ) {
        for (const [field, errorElement] of fieldErrors.entries()) {
          const messages = validation.errors[field] ?? [];
          errorElement.textContent = messages.join(" ");
          const control = fieldControls[field];
          if (control) {
            control.setAttribute(
              "aria-invalid",
              messages.length ? "true" : "false",
            );
          }
        }

        if (!validationSummary) {
          return;
        }

        if (!showSummary || validation.canSubmit) {
          validationSummary.hidden = true;
          validationSummary.replaceChildren();
          return;
        }

        const heading = document.createElement("strong");
        heading.textContent = "Please fix the highlighted fields:";
        const list = document.createElement("ul");
        for (const field of Object.keys(validation.errors) as FormField[]) {
          for (const message of validation.errors[field] ?? []) {
            const item = document.createElement("li");
            item.textContent = message;
            list.append(item);
          }
        }
        validationSummary.replaceChildren(heading, list);
        validationSummary.hidden = false;
      }

      function renderProgress(percent: number, show: boolean) {
        if (!progressWrap || !progressBar) {
          return;
        }

        progressWrap.hidden = !show;
        progressWrap.setAttribute("aria-valuenow", String(percent));
        progressBar.style.width = `${percent}%`;
      }

      function renderSubmittedSummary() {
        if (
          !jobSummary ||
          !summaryJob ||
          !summaryMode ||
          !summaryTitle ||
          !summaryOptions
        ) {
          return;
        }

        summaryJob.textContent = currentJobId ?? "Starting…";
        summaryMode.textContent =
          submittedValues.mode === "crawl" ? "Crawl" : "Single page";
        summaryTitle.textContent = submittedValues.title;
        summaryOptions.textContent = "EPUB";
        jobSummary.hidden = false;
      }

      function renderMessages(
        warnings: ApiWarning[],
        errors: ApiErrorBody[],
        warningHeading = "Warnings",
        errorHeading = "Errors",
      ) {
        renderMessageList(warningList, warnings, warningHeading);
        renderMessageList(errorList, errors, errorHeading);
      }

      function renderMessageList(
        container: HTMLElement | null,
        messages: Array<{ code: string; message: string; affected?: string }>,
        heading: string,
      ) {
        if (!container) {
          return;
        }

        if (!messages.length) {
          container.hidden = true;
          container.replaceChildren();
          return;
        }

        const title = document.createElement("strong");
        title.textContent = heading;
        const list = document.createElement("ul");
        for (const message of messages) {
          const item = document.createElement("li");
          item.textContent = statusMessageDisplayText(message);
          list.append(item);
        }
        container.replaceChildren(title, list);
        container.hidden = false;
      }

      function renderDownload(url: string | null) {
        if (!downloadLink) {
          return;
        }

        if (!url) {
          downloadLink.hidden = true;
          downloadLink.removeAttribute("href");
          downloadLink.setAttribute("aria-disabled", "true");
          return;
        }

        downloadLink.href = url;
        downloadLink.hidden = false;
        downloadLink.setAttribute("aria-disabled", "false");
      }

      function renderSubmitState() {
        if (!submitButton || !statusCard || !submitLabel) {
          return;
        }

        const authBlocked = !canUseAuthenticatedApi();
        const active = !canSubmitInPhase(phase);
        submitButton.disabled = active || authSession === null;
        submitButton.setAttribute("aria-busy", String(active));
        statusCard.dataset.phase = phase;
        statusCard.setAttribute("aria-busy", String(active));

        if (authSession === null) {
          submitLabel.textContent = "Checking sign-in…";
        } else if (authBlocked) {
          submitLabel.textContent = "Sign in with GitHub";
        } else if (phase === "submitting") {
          submitLabel.textContent = "Starting…";
        } else if (phase === "polling") {
          submitLabel.textContent = "Converting…";
        } else if (phase === "failed") {
          submitLabel.textContent = "Retry";
        } else if (phase === "completed") {
          submitLabel.textContent = "Forge another";
        } else {
          submitLabel.textContent = "Forge EPUB";
        }
      }

      function setPhase(nextPhase: UiPhase | "queued" | "running") {
        phase =
          nextPhase === "queued" || nextPhase === "running"
            ? "polling"
            : nextPhase;
        renderSubmitState();
      }

      function announce(message: string) {
        if (statusText) {
          statusText.textContent = message;
        }
      }

      function focusInvalidField(validation: ValidationResult) {
        const first = validation.firstInvalidField
          ? fieldControls[validation.firstInvalidField]
          : validationSummary;
        if (first instanceof HTMLElement) {
          first.focus();
        }
      }

      function readFormValues(): FormValues {
        if (!form) {
          return cloneDefaultFormValues();
        }

        const data = new FormData(form);
        const mode = data.get("mode") === "crawl" ? "crawl" : "single";
        return {
          sourceUrl: stringValue(data.get("sourceUrl")),
          mode,
          title: stringValue(data.get("title")),
          author: stringValue(data.get("author")),
          description: stringValue(data.get("description")),
          includeImages: data.has("includeImages"),
          useBrowser: data.has("useBrowser"),
          chapterStrategy:
            data.get("chapterStrategy") === "single-document"
              ? "single-document"
              : "source-order",
          outputTarget: "epub",
          crawlPrefixUrl: stringValue(data.get("crawlPrefixUrl")),
          maxDepth: stringValue(data.get("maxDepth")),
          maxPages: stringValue(data.get("maxPages")),
        };
      }

      function normalizeError(error: unknown): ApiErrorBody {
        if (error instanceof ApiClientError) {
          return {
            code: error.code,
            message: error.message,
            fields: error.fields,
          };
        }
        return {
          code: "network_error",
          message:
            "The conversion request could not be completed. Check the server and retry.",
          fields: [],
        };
      }

      function clearPollTimer() {
        if (pollTimer !== undefined) {
          window.clearInterval(pollTimer);
          pollTimer = undefined;
        }
      }

      function isTerminal(job: JobResponse): boolean {
        return job.status === "completed" || job.status === "failed";
      }

      function clampProgress(value: number): number {
        if (!Number.isFinite(value)) {
          return 0;
        }
        return Math.max(0, Math.min(100, Math.round(value)));
      }

      function stringValue(value: FormDataEntryValue | null): string {
        return typeof value === "string" ? value : "";
      }
    </script>
  </body>
</html>
